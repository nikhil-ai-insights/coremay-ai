rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is accessing their own document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Products collection: public read for shop, merchants can create/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Carts collection: owned by the user
    match /carts/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId);
    }

    // Orders collection: customer can read/write their own orders, merchants can read/update all orders
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read, write: if isSignedIn();
    }

    // AI Recommendations collection
    match /aiRecommendations/{recommendationId} {
      allow read, write: if isSignedIn();
    }

    // Audit logs collection: tracking all actions
    match /auditLogs/{auditId} {
      allow read, write: if isSignedIn();
    }

    // Merchant Analytics collection
    match /merchantAnalytics/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
